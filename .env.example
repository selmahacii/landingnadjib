# ID du Google Sheet contenant les onglets Commandes_et_Abandons, Tarifs_Livraison, etc.
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Email du compte de service Google (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Clé privée du compte de service Google (avec \n pour les retours à la ligne)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Token Vercel Blob pour le stockage et l'optimisation des images média
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# ID du Pixel Meta pour le suivi client (browser)
META_PIXEL_ID=123456789012345

# Token d'accès Meta Conversions API (CAPI) pour le suivi serveur
META_CAPI_TOKEN=EAAxxxxxxxxx

# Code optionnel pour tester les événements dans Meta Events Manager
META_TEST_EVENT_CODE=TEST12345

# Code PIN / Secret admin pour accéder à /admin et signer les cookies de session (HMAC-SHA256)
ADMIN_SECRET_KEY=supersecretpin1234
